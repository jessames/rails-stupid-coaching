<!DOCTYPE html>
<html>
  <head>
    <title>RailsFirstApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <blockquote class="blockquote p-3"><%= @question %></blockquote>
    <blockquote class="blockquote p-3"><%= @answer %></blockquote>
    <div class="p-3"><button class="btn-lg p-3"><%= link_to "Ask a new question", ask_path %></button></div>
  </body>
</html>
